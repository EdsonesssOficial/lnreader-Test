diff -ruN '--exclude=node_modules' orig/lnreader-master/src/screens/reader/hooks/useTtsBackgroundMusic.ts lnreader-master/src/screens/reader/hooks/useTtsBackgroundMusic.ts
--- a/src/screens/reader/hooks/useTtsBackgroundMusic.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/screens/reader/hooks/useTtsBackgroundMusic.ts	2026-11-12 09:05:35.997308970 +0000
@@ -0,0 +1,64 @@
+import { useEffect, useRef } from 'react';
+
+import type { TtsPlaybackState } from '@modules/nitro-tts';
+import { backgroundMusicController } from '@services/backgroundMusic/backgroundMusicController';
+import {
+  BackgroundMusicSettings,
+  getSourcesSignature,
+  normalizeBackgroundMusicSettings,
+} from '@services/backgroundMusic/types';
+
+/** Avoids a pause/resume blip when TTS briefly leaves `playing`. */
+const PAUSE_DEBOUNCE_MS = 400;
+
+/**
+ * Keeps the background music in step with the TTS session: it plays while the
+ * voice is reading and pauses (without losing its position) otherwise.
+ */
+export const useTtsBackgroundMusic = (
+  ttsState: TtsPlaybackState,
+  stored?: Partial<BackgroundMusicSettings>,
+) => {
+  const settings = normalizeBackgroundMusicSettings(stored);
+  const { enabled, volume, pitch, repeat, shuffle } = settings;
+  const sourcesSignature = getSourcesSignature(settings.sources);
+
+  const settingsRef = useRef(settings);
+  const pauseTimerRef = useRef<ReturnType<typeof setTimeout> | null>(null);
+
+  useEffect(() => {
+    settingsRef.current = settings;
+  });
+
+  useEffect(() => {
+    if (enabled) {
+      backgroundMusicController.applySettings(settingsRef.current);
+    }
+  }, [enabled, volume, pitch, repeat, shuffle]);
+
+  useEffect(() => {
+    if (pauseTimerRef.current) {
+      clearTimeout(pauseTimerRef.current);
+      pauseTimerRef.current = null;
+    }
+    if (!enabled) {
+      backgroundMusicController.stop();
+    } else if (ttsState === 'playing') {
+      void backgroundMusicController.play(settingsRef.current);
+    } else if (ttsState !== 'loading') {
+      pauseTimerRef.current = setTimeout(() => {
+        backgroundMusicController.pause();
+      }, PAUSE_DEBOUNCE_MS);
+    }
+  }, [enabled, ttsState, sourcesSignature]);
+
+  useEffect(
+    () => () => {
+      if (pauseTimerRef.current) {
+        clearTimeout(pauseTimerRef.current);
+      }
+      backgroundMusicController.stop();
+    },
+    [],
+  );
+};
diff -ruN '--exclude=node_modules' orig/lnreader-master/src/services/backgroundMusic/backgroundMusicController.ts lnreader-master/src/services/backgroundMusic/backgroundMusicController.ts
--- a/src/services/backgroundMusic/backgroundMusicController.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/services/backgroundMusic/backgroundMusicController.ts	2026-11-12 09:05:35.996984403 +0000
@@ -0,0 +1,206 @@
+import { create } from 'zustand';
+
+import NativeFile from '@modules/native-file';
+import BackgroundMusic, { MusicTrack } from '@modules/native-background-music';
+import { showToast } from '@utils/showToast';
+import {
+  BackgroundMusicSettings,
+  MusicSource,
+  getSourcesSignature,
+} from './types';
+
+interface BackgroundMusicState {
+  trackName?: string;
+  trackCount: number;
+  error?: string;
+}
+
+export const useBackgroundMusicStore = create<BackgroundMusicState>(() => ({
+  trackCount: 0,
+}));
+
+let tracks: MusicTrack[] = [];
+let loadedSignature: string | undefined;
+let requestId = 0;
+let used = false;
+let subscribed = false;
+
+const stripExtension = (name: string) => name.replace(/\.[^./]+$/, '');
+
+const subscribe = () => {
+  if (subscribed) {
+    return;
+  }
+  subscribed = true;
+  BackgroundMusic.addListener('onTrackChanged', ({ index }) => {
+    const track = tracks[index];
+    useBackgroundMusicStore.setState({
+      trackName: track ? stripExtension(track.name) : undefined,
+      error: undefined,
+    });
+  });
+  BackgroundMusic.addListener('onEnded', () => {
+    useBackgroundMusicStore.setState({ trackName: undefined });
+  });
+  BackgroundMusic.addListener('onError', ({ message }) => {
+    useBackgroundMusicStore.setState({ error: message });
+  });
+};
+
+const resolveTracks = async (sources: MusicSource[]) => {
+  const seen = new Set<string>();
+  const resolved: MusicTrack[] = [];
+  for (const source of sources) {
+    let found: MusicTrack[];
+    try {
+      found =
+        source.type === 'folder'
+          ? await BackgroundMusic.listTracks(source.uri, true)
+          : [{ uri: source.uri, name: source.name }];
+    } catch {
+      // Folder removed or access revoked: skip it, the others still play.
+      found = [];
+    }
+    for (const track of found) {
+      if (!seen.has(track.uri)) {
+        seen.add(track.uri);
+        resolved.push(track);
+      }
+    }
+  }
+  return resolved;
+};
+
+const applyPlaybackSettings = (settings: BackgroundMusicSettings) => {
+  BackgroundMusic.setVolume(settings.volume);
+  BackgroundMusic.setPitch(settings.pitch);
+  BackgroundMusic.setRepeat(settings.repeat);
+  BackgroundMusic.setShuffle(settings.shuffle);
+};
+
+const isCancellation = (error: unknown) =>
+  (error as { code?: string } | undefined)?.code === 'ECANCELLED';
+
+export const backgroundMusicController = {
+  /** Starts or resumes the music; reloads the queue if sources changed. */
+  async play(settings: BackgroundMusicSettings) {
+    const id = ++requestId;
+    if (!settings.enabled || settings.sources.length === 0) {
+      this.stop();
+      return;
+    }
+    used = true;
+    subscribe();
+
+    const signature = getSourcesSignature(settings.sources);
+    if (signature !== loadedSignature) {
+      const resolved = await resolveTracks(settings.sources);
+      if (id !== requestId) {
+        return;
+      }
+      if (resolved.length === 0) {
+        useBackgroundMusicStore.setState({
+          trackCount: 0,
+          trackName: undefined,
+          error: 'No audio files found in the selected sources',
+        });
+        return;
+      }
+      tracks = resolved;
+      loadedSignature = signature;
+      const startIndex = settings.shuffle
+        ? Math.floor(Math.random() * resolved.length)
+        : 0;
+      BackgroundMusic.setQueue(
+        resolved.map(track => track.uri),
+        startIndex,
+        settings.shuffle,
+      );
+      useBackgroundMusicStore.setState({
+        trackCount: resolved.length,
+        error: undefined,
+      });
+    }
+
+    applyPlaybackSettings(settings);
+    BackgroundMusic.play();
+  },
+
+  pause() {
+    requestId += 1;
+    if (used) {
+      BackgroundMusic.pause();
+    }
+  },
+
+  /** Releases the player and forgets the queue (folders are re-read later). */
+  stop() {
+    requestId += 1;
+    if (!used) {
+      return;
+    }
+    BackgroundMusic.stop();
+    tracks = [];
+    loadedSignature = undefined;
+    useBackgroundMusicStore.setState({
+      trackName: undefined,
+      trackCount: 0,
+      error: undefined,
+    });
+  },
+
+  applySettings(settings: BackgroundMusicSettings) {
+    if (used && settings.enabled) {
+      applyPlaybackSettings(settings);
+    }
+  },
+
+  next() {
+    if (used) {
+      BackgroundMusic.next();
+    }
+  },
+
+  previous() {
+    if (used) {
+      BackgroundMusic.previous();
+    }
+  },
+
+  async pickFolder(): Promise<MusicSource | undefined> {
+    try {
+      const { uri, name } = await NativeFile.pickDirectory();
+      const source: MusicSource = {
+        id: `folder:${uri}`,
+        type: 'folder',
+        uri,
+        name,
+      };
+      return source;
+    } catch (error) {
+      if (!isCancellation(error)) {
+        showToast(error instanceof Error ? error.message : String(error));
+      }
+      return undefined;
+    }
+  },
+
+  async pickFiles(): Promise<MusicSource[]> {
+    try {
+      const picked = await BackgroundMusic.pickAudioFiles();
+      return picked.map(
+        (track): MusicSource => ({
+          id: `file:${track.uri}`,
+          type: 'file',
+          uri: track.uri,
+          name: track.name,
+        }),
+      );
+    } catch (error) {
+      if (!isCancellation(error)) {
+        showToast(error instanceof Error ? error.message : String(error));
+      }
+      return [];
+    }
+  },
+};
diff -ruN '--exclude=node_modules' orig/lnreader-master/src/services/backgroundMusic/types.ts lnreader-master/src/services/backgroundMusic/types.ts
--- a/src/services/backgroundMusic/types.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/services/backgroundMusic/types.ts	2026-11-12 09:03:43.742988127 +0000
@@ -0,0 +1,58 @@
+import type { MusicRepeatMode } from '@modules/native-background-music';
+
+export type { MusicRepeatMode };
+
+export interface MusicSource {
+  /** Stable key: `folder:<uri>` or `file:<uri>`. */
+  id: string;
+  type: 'folder' | 'file';
+  uri: string;
+  name: string;
+}
+
+export interface BackgroundMusicSettings {
+  enabled: boolean;
+  sources: MusicSource[];
+  /** 0..1 */
+  volume: number;
+  /** 0.5..2 */
+  pitch: number;
+  repeat: MusicRepeatMode;
+  shuffle: boolean;
+}
+
+export const defaultBackgroundMusicSettings: BackgroundMusicSettings = {
+  enabled: false,
+  sources: [],
+  volume: 0.4,
+  pitch: 1,
+  repeat: 'all',
+  shuffle: false,
+};
+
+export const normalizeBackgroundMusicSettings = (
+  stored?: Partial<BackgroundMusicSettings>,
+): BackgroundMusicSettings => ({
+  ...defaultBackgroundMusicSettings,
+  ...stored,
+  sources: stored?.sources ?? [],
+});
+
+/** Identifies the queue contents, ignoring playback options. */
+export const getSourcesSignature = (sources: MusicSource[]): string =>
+  sources.map(source => source.id).join('|');
+
+export const mergeSources = (
+  current: MusicSource[],
+  added: MusicSource[],
+): MusicSource[] => {
+  const known = new Set(current.map(source => source.id));
+  const merged = [...current];
+  for (const source of added) {
+    if (!known.has(source.id)) {
+      known.add(source.id);
+      merged.push(source);
+    }
+  }
+  return merged;
+};
