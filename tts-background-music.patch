--- a/modules/native-background-music/android/src/main/java/expo/modules/nativebackgroundmusic/BackgroundMusicPlayer.kt	1970-01-01 00:00:00.000000000 +0000
+++ b/modules/native-background-music/android/src/main/java/expo/modules/nativebackgroundmusic/BackgroundMusicPlayer.kt	2026-11-12 09:03:43.736295295 +0000
